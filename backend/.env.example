# PulmoVision AI Environment Configuration
APP_NAME="PulmoVision AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false

# Security (Replace JWT_SECRET_KEY in production)
JWT_SECRET_KEY="pulmovision-research-secret-key-change-in-production-9f8e7d6c5b4a3"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database (PostgreSQL in production: postgresql+psycopg2://user:pass@localhost:5432/pulmovision)
DATABASE_URL="sqlite:///./pulmovision.db"

# Storage & Model Cache
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./storage"
MODEL_CACHE_PATH="./model_cache"
MAX_UPLOAD_SIZE_MB=512

# AI Inference Hardware Guardrails (Tuned for 7.68 GB RAM Intel Core i5-1235U Host)
INFERENCE_DEVICE="cpu"
INFERENCE_BATCH_SIZE=4
INFERENCE_CPU_THREADS=6
MAX_CONCURRENT_JOBS=1

# CORS
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

