# ==========================================
# PulmoVision AI — Git Ignore Configuration
# ==========================================

# Python runtime and packaging
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
dist/
build/
eggs/
.eggs/
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# PulmoVision Runtime Storage & Local Databases
*.db
*.sqlite
*.sqlite3
backend/storage/
backend/model_cache/
backend/pulmovision.db*

# Medical Imaging Large Binary Scan Files (prevent committing bulky patient data)
*.dcm
*.nii
*.nii.gz
*.mha
*.mhd
!sample_data/README.md

# Pretrained Model Weights (downloaded dynamically at runtime via adapter)
*.pth
*.pt
*.onnx
*.bin
*.h5
*.safetensors

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating System & IDE Specific
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
