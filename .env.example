# ==========================================
# PulmoVision AI — Environment Configuration Template
# ==========================================
# Copy this file to backend/.env for local configuration:
#   Copy-Item .env.example backend/.env

# Application Identity & Mode
APP_NAME="PulmoVision AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false

# Security & Authentication (Generate a cryptographically secure key for production)
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./pulmovision.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+psycopg2://pulmo_user:change_password@localhost:5432/pulmovision"

# Storage & Model Cache Paths
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./storage"
MODEL_CACHE_PATH="./model_cache"
MAX_UPLOAD_SIZE_MB=512

# AI Hardware Guardrails (Tuned for Host CPU & RAM)
INFERENCE_DEVICE="cpu"
INFERENCE_BATCH_SIZE=4
INFERENCE_CPU_THREADS=6
MAX_CONCURRENT_JOBS=1

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

